# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# data pipeline (raw sources are downloaded, not committed)
data/raw/*
!data/raw/.gitkeep

# Verified staging packages are generated from the Incheon input manifest.
/data/output/

# Local analysis snapshots and browser screenshots; published summaries live in docs.
/data/interim/incheon/
/output/

# superpowers / agent scratch state
.superpowers/

# playwright
playwright-report/
test-results/

# local env overrides
.env*.local

# Claude Code agent worktrees / local settings
.claude/worktrees/
.claude/settings.local.json
